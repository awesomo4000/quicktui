+/// Emit ordinary terminal text, never tmux passthrough, so pane redraws retain it.
+/// Encode all coordinates explicitly to preserve clipping and partial redraws.
+pub fn writeKittyPlaceholder(writer: anytype, id: u32, placement_id: u32, row: u32, col: u32) !void {
+    if (row >= placeholder_diacritics.len or col >= placeholder_diacritics.len) return error.ImageTooLarge;
+    try writer.print("\x1b[38;2;{d};{d};{d}m\x1b[58;2;{d};{d};{d}m", .{
+        (id >> 16) & 255,           (id >> 8) & 255,           id & 255,
+        (placement_id >> 16) & 255, (placement_id >> 8) & 255, placement_id & 255,
+    });
+    var bytes: [4]u8 = undefined;
+    for ([_]u21{ 0x10EEEE, placeholder_diacritics[row], placeholder_diacritics[col], placeholder_diacritics[id >> 24] }) |cp| {
+        const len = try std.unicode.utf8Encode(cp, &bytes);
+        try writer.writeAll(bytes[0..len]);
+    }
+}
